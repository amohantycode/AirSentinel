# Copy to .env.local. Leave unused values blank, then restart the app.
# The app shell and bundled observation map work without credentials.

# Server-only: current conditions and forecasts (https://www.weatherapi.com/)
WEATHER_API_KEY=

# Optional browser-visible map key. Restrict allowed origins and APIs.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAPS_PROVIDER=google

# Optional database features. Review SQL policies before configuring.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Do not configure a service-role key on a public deployment until the
# observation write endpoint has caller authentication and authorization.
# See docs/development.md for details.
