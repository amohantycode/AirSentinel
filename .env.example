# ===========================================
# AirSentinel Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your keys

# WeatherAPI (required for air quality forecasts)
# Get a free key at: https://www.weatherapi.com/
WEATHER_API_KEY=your_weatherapi_key_here

# Google Maps (required for map features)
# Get from: https://console.cloud.google.com/
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Mapbox (alternative to Google Maps)
# Get from: https://www.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# Maps Provider: 'google' or 'mapbox'
NEXT_PUBLIC_MAPS_PROVIDER=google

# Supabase (optional - for database features)
# Get from: https://supabase.com/
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

